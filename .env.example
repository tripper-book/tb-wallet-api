# Server
PORT=3000
NODE_ENV=development

# Set to true to run without database (Swagger and health still work)
SKIP_DB=false

# MySQL (used when SKIP_DB is not true)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tb_wallet

# PayU Hosted Checkout (Web)
# Docs: https://docs.payu.in/docs/prebuilt-checkout-page-integration
# Test: https://test.payu.in/_payment | Live: https://secure.payu.in/_payment
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=TEST
# Callback URLs PayU will POST to (this API). Use full URL e.g. https://your-api.com/orders/payu/success
PAYU_SUCCESS_URL=
PAYU_FAILURE_URL=
# Where to redirect user after payment (frontend). e.g. https://yourapp.com/order/success
PAYU_SUCCESS_REDIRECT_URL=
PAYU_FAILURE_REDIRECT_URL=
